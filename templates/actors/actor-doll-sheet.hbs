<form class="{{cssClass}} nechronica-sheet" autocomplete="off">
  <header class="doll-header">
    <div class="portrait-block">
      <div class="portrait">
        <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
      </div>
    </div>

    <div class="name-block">
      <input class="character-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize "NECH.Name"}}"/>
    </div>

    <div class="place-block">
      <div class="placement-box">
        <span>{{localize "NECH.Placement"}}</span>
        <div class="placement-options">
          {{radioBoxes "system.placement" config.placements checked=actor.system.placement localize=true}}
        </div>
      </div>
    </div>
    
    <div class="hp-block">
      {{!-- Overall HP --}}
      <div class="hp-total">
        <span class="hp-label">
          {{localize "NECH.HP"}}
        </span>
        <strong>
          {{system.hp.value}} / {{system.hp.max}}
        </strong>
        <div class="resource-bar">
          <div
            class="resource-bar-fill"
            style="
              width: {{system.hp.rate}}%;
              background: {{system.hp.color}};
            "
          ></div>
        </div>
      </div>

      {{!-- Location HP --}}
      <div class="hp-locations">

        {{!-- Head --}}
        <div
          class="hp-location
            {{#if (eq system.hp.head.value 0)}}is-zero{{/if}}"
        >
          <span class="hp-location-name">{{localize "NECH.Locations.Head"}}</span>

          <strong>
            {{system.hp.head.value}} / {{system.hp.head.max}}
          </strong>
        </div>

        {{!-- Arms --}}
        <div
          class="hp-location
            {{#if (eq system.hp.arms.value 0)}}is-zero{{/if}}"
        >
          <span class="hp-location-name">{{localize "NECH.Locations.Arms"}}</span>

          <strong>
            {{system.hp.arms.value}} / {{system.hp.arms.max}}
          </strong>
        </div>

        {{!-- Torso --}}
        <div
          class="hp-location
            {{#if (eq system.hp.torso.value 0)}}is-zero{{/if}}"
        >
          <span class="hp-location-name">{{localize "NECH.Locations.Torso"}}</span>

          <strong>
            {{system.hp.torso.value}} / {{system.hp.torso.max}}
          </strong>
        </div>

        {{!-- Legs --}}
        <div
          class="hp-location
            {{#if (eq system.hp.legs.value 0)}}is-zero{{/if}}"
        >
          <span class="hp-location-name">{{localize "NECH.Locations.Legs"}}</span>

          <strong>
            {{system.hp.legs.value}} / {{system.hp.legs.max}}
          </strong>
        </div>

      </div>

    </div>

  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item active" data-tab="parts">{{localize "NECH.Parts"}}</a>
    <a class="item" data-tab="status">{{localize "NECH.Params"}}</a>
    <a class="item" data-tab="biography">{{localize "NECH.Biography"}}</a>
    <a class="item" data-tab="notes">{{localize "NECH.Notes"}}</a>
  </nav>

  <div class="sheet-body {{#if (lookup this.hiddenElems "doll-header")}}small-header{{/if}}">
    <div class="tab parts" data-group="primary" data-tab="parts">
      {{> "systems/nechronica-fvtt/templates/actors/parts/parts-ol.hbs"}}
    </div>
    <div class="tab status" data-group="primary" data-tab="status">
      {{> "systems/nechronica-fvtt/templates/actors/parts/status.hbs"}}
    </div>

    <div class="tab biography flexcol" data-group="primary" data-tab="biography">
      {{> "systems/nechronica-fvtt/templates/actors/parts/biography.hbs"}}
    </div>
    <div class="tab actor-notes flexcol" data-group="primary" data-tab="notes">
      {{editor system.details.notes target="system.details.notes" rollData=rollData button=true owner=owner editable=editable}}
    </div>
  </div>
</form>
